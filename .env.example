# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/warrior-ticket

# Portal Configuration
PORTAL_PASSWORD=WarriorTicket@123
PORTAL_PORT=3000

# Owner ID (for watermark)
OWNER_ID=your_discord_id

# Logs Channel ID
LOGS_CHANNEL_ID=your_channel_id

# Admin Role ID
ADMIN_ROLE_ID=your_admin_role_id

# Support Role IDs (comma separated if multiple)
SUPPORT_ROLE_IDS=support_role_id_1,support_role_id_2

# Server ID
SERVER_ID=your_server_id

# Portal Secret
PORTAL_SECRET=your_super_secret_key_here_min_32_chars

# Environment
NODE_ENV=production

# Portal Access URL (for Railway)
PORTAL_URL=http://localhost:3000
